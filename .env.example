# ============================================================
# .env.example — Student-Document-OCR
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# ── App ──────────────────────────────────────────────────────
APP_NAME=student-document-ocr
APP_ENV=development           # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY
APP_PORT=8000
APP_HOST=0.0.0.0

# ── Database (PostgreSQL) ────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ocr_db
POSTGRES_USER=ocr_user
POSTGRES_PASSWORD=CHANGE_ME
# URL dùng cho FastAPI async engine (SQLAlchemy 2.0 + asyncpg)
DATABASE_URL=postgresql+asyncpg://ocr_user:CHANGE_ME@localhost:5432/ocr_db
# URL dùng cho Alembic migration (chạy sync, cần psycopg2 driver)
ALEMBIC_DATABASE_URL=postgresql+psycopg2://ocr_user:CHANGE_ME@localhost:5432/ocr_db

# ── Elasticsearch ────────────────────────────────────────────
ES_HOST=localhost
ES_PORT=9200
ES_INDEX_DOCUMENTS=documents
ES_USERNAME=elastic
ES_PASSWORD=CHANGE_ME

# ── MinIO / S3 Object Storage ────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_THUMBNAILS=thumbnails
MINIO_USE_SSL=false

# ── Redis (Cache / Queue) ────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0

# ── Celery (Async Task Queue) ────────────────────────────────
CELERY_BROKER_URL=redis://:CHANGE_ME@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME@localhost:6379/1

# ── OCR Engine ───────────────────────────────────────────────
OCR_ENGINE=vietocr              # vietocr | paddleocr
OCR_MODEL_PATH=./models/vietocr_transformer.pth
OCR_DEVICE=cpu                  # cpu | cuda | mps
OCR_BEAM_WIDTH=5
OCR_BATCH_SIZE=8

# ── JWT Authentication ───────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_TO_A_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FILE=./logs/app.log

# ── Frontend (React) ─────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=Student Document OCR

# ── Monitoring ───────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
FLOWER_PORT=5555
